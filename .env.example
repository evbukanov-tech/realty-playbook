# Neon: pooled connection (для приложения на Vercel / serverless)
# Важно: без channel_binding=require — на Vercel может ломать подключение
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Neon: direct connection (для миграций Prisma, локально)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# view-db (опционально): явные URL для локальной и рабочей БД
# Если не заданы — локальная: DIRECT_URL → DATABASE_URL, рабочая: DATABASE_URL
# DATABASE_URL_LOCAL="postgresql://USER:PASSWORD@localhost:5432/realty_playbook"
# DATABASE_URL_WORK="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
